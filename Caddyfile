# Адрес(а), которые слушает Caddy, задаются переменной CADDY_SITE_ADDRESS
# (см. docker-compose.yml и .env). По умолчанию — значение DOMAIN.
#
# Caddy сам решает, как выдавать сертификат, по виду адреса:
# - настоящий домен            -> Let's Encrypt, доверенный всеми браузерами;
# - localhost или IP-адрес     -> собственный локальный CA (браузер предупредит
#                                 о недоверенном сертификате — это ожидаемо);
# - адрес с префиксом http://  -> HTTPS не включается вовсе, отдаётся обычный
#                                 HTTP. Удобно для доступа по IP внутри сети,
#                                 когда предупреждения браузера мешают.
#
# Примеры значений CADDY_SITE_ADDRESS:
#   donorgarage.ru, www.donorgarage.ru   боевой домен вместе с www
#   localhost                            локальная проверка на этой же машине
#   http://192.168.88.122                доступ по IP из локальной сети, без TLS
{$CADDY_SITE_ADDRESS} {
	# Если запрос пришёл на www-хост, уводим на канонический адрес без www:
	# PUBLIC_URL, ссылки в письмах сброса пароля и redirect URI у OAuth и оплаты
	# завязаны на один origin, и работа сайта сразу с двух хостов их бы рассогласовала.
	# Когда www в CADDY_SITE_ADDRESS не указан, этот матчер просто никогда не срабатывает.
	@www host www.{$DOMAIN}
	redir @www https://{$DOMAIN}{uri} permanent

	reverse_proxy frontend:80
}
