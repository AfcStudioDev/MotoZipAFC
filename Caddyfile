# {$DOMAIN} подставляется Caddy из переменной окружения контейнера (см. docker-compose.yml).
#
# Caddy включает HTTPS и редирект HTTP → HTTPS всегда, независимо от DOMAIN:
# - для настоящего публичного домена сам получает и продлевает сертификат
#   Let's Encrypt — доверенный всеми браузерами без дополнительных действий;
# - для localhost/IP (публичного DNS-имени нет, Let's Encrypt его не выдаст)
#   использует свой собственный локальный CA — браузер один раз спросит,
#   доверять ли сертификату (это ожидаемо и безопасно для локальной проверки).
{$DOMAIN} {
	reverse_proxy frontend:80
}
