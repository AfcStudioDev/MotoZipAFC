{
  // Этот файл под git — здесь только значения по умолчанию, без секретов.
  // Реальные значения берутся (в порядке приоритета):
  //   1. переменные окружения — ConnectionStrings__Default, Jwt__Key и т.д. (так работает docker-compose);
  //   2. appsettings.Development.json — локальная разработка, файл в .gitignore.
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "MotoParts",
    "Audience": "MotoPartsClient",
    "Key": ""
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },
  "OAuth": {
    "Google": {
      "ClientId": ""
    },
    "Vk": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "YooKassa": {
    "ShopId": "",
    "SecretKey": ""
  },
  // Онлайн-оплата (ЮKassa) сейчас отключена — покупатель переводит деньги по номеру карты
  // вручную и прикладывает чек (см. OrdersController.PaymentInfo). Задайте Payment__CardNumber
  // в окружении или appsettings.Development.json.
  "Payment": {
    "CardNumber": ""
  },
  "Smtp": {
    "Host": "",
    "Port": "587",
    "EnableSsl": "true",
    "User": "",
    "Password": "",
    "From": ""
  },
  // Учётка первого администратора. Пустой пароль означает «не создавать» — задайте
  // Seed__AdminEmail и Seed__AdminPassword в окружении при первом развёртывании.
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
