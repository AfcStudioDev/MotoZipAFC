<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Только HTTP: маршруты, авторизация, сериализация. Вся работа с БД и внешними
       сервисами — через Application и Infrastructure. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
    <UserSecretsId>59ffef59-0c6e-4ad0-8eef-049092c5e928</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MotoParts.Application\MotoParts.Application.csproj" />
    <ProjectReference Include="..\MotoParts.Infrastructure\MotoParts.Infrastructure.csproj" />
  </ItemGroup>

  <!-- git mergetool оставляет рядом с конфликтным файлом копии *_BACKUP_/_BASE_/_LOCAL_/_REMOTE_.
       В Controllers они попадали в компиляцию и ломали сборку, а хуже того — в них лежит старая
       версия AdminController с обобщённым PUT {table}/{id}, который мы убрали как уязвимость.
       Такие копии не должны собираться никогда; их можно спокойно удалять с диска. -->
  <ItemGroup>
    <Compile Remove="**\*_BACKUP_*.cs;**\*_BASE_*.cs;**\*_LOCAL_*.cs;**\*_REMOTE_*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\Labels\" />
  </ItemGroup>

  <!-- Логотип для водяного знака не под wwwroot, поэтому SDK не публикует его сам по себе —
       без этого он остаётся только в исходниках и пропадает при publish (в т.ч. в Docker-образе). -->
  <ItemGroup>
    <Content Include="Images\watermark.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
