# ============================================================
# Скопируйте этот файл в .env и заполните реальными значениями:
#
#   cp .env.example .env
#
# .env НЕ коммитится в git (см. .gitignore) — в нём секреты.
# После изменения .env примените их так:
#
#   docker compose up -d --build
# ============================================================

# ---------- Публичный адрес сайта ----------
# DOMAIN       — канонический хост (без схемы и порта). На него уводит редирект
#                с www, из него бэкенд берёт CORS и ссылки в письмах.
# PUBLIC_URL   — тот же хост, но со схемой (нужен бэкенду).
# CADDY_SITE_ADDRESS — что именно слушает Caddy. Если не задан, берётся DOMAIN.
#                Задавайте отдельно, когда нужен www или доступ по IP без TLS.
#
# --- Вариант 1: локальная проверка на этой же машине (по умолчанию) ---
DOMAIN=localhost
PUBLIC_URL=https://localhost
# CADDY_SITE_ADDRESS не нужен — возьмётся localhost.
# Сертификат выдаст локальный CA Caddy, браузер один раз спросит о доверии.
#
# --- Вариант 2: боевой домен (A-запись уже указывает на IP сервера) ---
# DOMAIN=motoparts.example.com
# PUBLIC_URL=https://motoparts.example.com
# CADDY_SITE_ADDRESS=motoparts.example.com, www.motoparts.example.com
# Сертификат Let's Encrypt получится автоматически. Строку с www добавляйте,
# только если у домена есть A-запись для www, иначе Caddy будет впустую
# запрашивать для него сертификат.
#
# --- Вариант 3: доступ по IP из локальной сети (без TLS) ---
# Для IP-адреса Let's Encrypt сертификат не выдаст, а локальный CA не вызывает
# доверия на других устройствах — поэтому проще отдавать обычный HTTP.
# Префикс http:// в CADDY_SITE_ADDRESS отключает HTTPS для этого адреса.
# DOMAIN=192.168.1.50
# PUBLIC_URL=http://192.168.1.50
# CADDY_SITE_ADDRESS=http://192.168.1.50

# ---------- PostgreSQL ----------
POSTGRES_DB=motoparts
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password

# ---------- JWT ----------
JWT_ISSUER=MotoParts
JWT_AUDIENCE=MotoPartsClient
# Обязательно замените — минимум 32 символа, случайная строка.
JWT_KEY=change_me_random_secret_key_min_32_characters_long

# ---------- Служебные учётки (создаются автоматически при первом запуске) ----------
SEED_ADMIN_EMAIL=admin@motoparts.local
SEED_ADMIN_PASSWORD=change_me
SEED_SENDER_EMAIL=sender@motoparts.local
SEED_SENDER_PASSWORD=change_me
SEED_REGISTRAR_EMAIL=registrar@motoparts.local
SEED_REGISTRAR_PASSWORD=change_me

# ---------- OAuth (необязательно) ----------
GOOGLE_CLIENT_ID=
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# ---------- ЮKassa (необязательно, нужно для приёма оплаты) ----------
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ---------- SMTP (необязательно; без него ссылка сброса пароля пишется в лог бэкенда) ----------
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ---------- Адрес API для фронтенда ----------
# По умолчанию относительный путь: nginx проксирует /api на контейнер бэкенда,
# фронтенд и бэкенд работают с одного origin, поэтому CORS браузеру не нужен.
# Меняйте, только если бэкенд разворачивается отдельно от фронтенда.
API_URL=/api
