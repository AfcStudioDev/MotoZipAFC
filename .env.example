# ============================================================
# Скопируйте этот файл в .env и заполните реальными значениями:
#
#   cp .env.example .env
#
# .env НЕ коммитится в git (см. .gitignore) — в нём секреты.
# После изменения .env примените их так:
#
#   docker compose up -d --build
# ============================================================

# ---------- Публичный адрес сайта ----------
# DOMAIN и PUBLIC_URL должны указывать на один и тот же хост — DOMAIN нужен
# Caddy (без схемы и порта, только имя хоста), PUBLIC_URL нужен бэкенду для
# CORS и ссылок в письмах (со схемой). Caddy включает HTTPS в обоих случаях:
# для настоящего домена — доверенный сертификат Let's Encrypt; для localhost/IP —
# свой локальный CA (браузер один раз спросит, доверять ли — это нормально).
#
# Локально (по умолчанию):
DOMAIN=localhost
PUBLIC_URL=https://localhost
#
# На реальном сервере (домен должен уже указывать A-записью на IP сервера):
# DOMAIN=motoparts.example.com
# PUBLIC_URL=https://motoparts.example.com

# ---------- PostgreSQL ----------
POSTGRES_DB=motoparts
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password

# ---------- JWT ----------
JWT_ISSUER=MotoParts
JWT_AUDIENCE=MotoPartsClient
# Обязательно замените — минимум 32 символа, случайная строка.
JWT_KEY=change_me_random_secret_key_min_32_characters_long

# ---------- Служебные учётки (создаются автоматически при первом запуске) ----------
SEED_ADMIN_EMAIL=admin@motoparts.local
SEED_ADMIN_PASSWORD=change_me
SEED_SENDER_EMAIL=sender@motoparts.local
SEED_SENDER_PASSWORD=change_me
SEED_REGISTRAR_EMAIL=registrar@motoparts.local
SEED_REGISTRAR_PASSWORD=change_me

# ---------- OAuth (необязательно) ----------
GOOGLE_CLIENT_ID=
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# ---------- ЮKassa (необязательно, нужно для приёма оплаты) ----------
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ---------- SMTP (необязательно; без него ссылка сброса пароля пишется в лог бэкенда) ----------
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ---------- Адрес API для фронтенда ----------
# По умолчанию относительный путь: nginx проксирует /api на контейнер бэкенда,
# фронтенд и бэкенд работают с одного origin, поэтому CORS браузеру не нужен.
# Меняйте, только если бэкенд разворачивается отдельно от фронтенда.
API_URL=/api
