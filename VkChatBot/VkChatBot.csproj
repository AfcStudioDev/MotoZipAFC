<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VkBotFramework" Version="1.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <!-- Не под git (см. .gitignore) — реальный токен только тут, для локального запуска
       консольного listener'а (Program.cs), который читает его из рабочей директории
       через AddJsonFile (см. Program.cs) — копировать в bin не нужно.
       ВАЖНО: если пометить этот файл как Content с CopyToOutputDirectory, MSBuild
       транзитивно скопирует его (вместе с боевым токеном) и в bin-папку MotoParts.Api —
       проект ссылается на VkChatBot через ProjectReference. Реальный сервис (VkBotService)
       конфигурацию из этого файла не читает вообще: он получает IConfiguration от хоста
       и берёт токен только из общих appsettings.json/appsettings.*.json API. См. appsettings.local.json.example. -->

</Project>
